{% block html %}
{% set dataPlacement_choices = {'top': true, 'left': true, 'right': true, 'bottom': true} %}
{% set dataTheme_choices = {'light': true, 'dark': true} %}
{% set dir_choices = {'ltr': true, 'rtl': true, 'auto': true} %}
<html
  {% if dataPlacement is defined and dataPlacement|length > 0 and dataPlacement_choices[dataPlacement] is defined %}data-placement="{{ dataPlacement }}"{% endif %}
  {% if dataTheme is defined and dataTheme|length > 0 and dataTheme_choices[dataTheme] is defined %}data-theme="{{ dataTheme }}"{% endif %}
  {% if dataTooltip is defined and dataTooltip|length > 0 %}data-tooltip="{{ dataTooltip }}"{% endif %}
  {% if dir is defined and dir|length > 0 and dir_choices[dir] is defined %}dir="{{ dir }}"{% endif %}
  {% if lang is defined and lang|length > 0 %}lang="{{ lang }}"{% endif %}
  {% if manifest is defined and manifest|length > 0 %}manifest="{{ manifest }}"{% endif %}>
  {% block content %}{{- content|raw -}}{% endblock %}
</html>
{% endblock %}
